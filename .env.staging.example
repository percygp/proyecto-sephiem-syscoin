# ─────────────────────────────────────────────────────────────
# Sephiem · Staging environment template (VAL-45 / [B1])
# Copiar a `.env.staging` (gitignored) y rellenar con valores reales.
# NUNCA commitear valores reales. NUNCA usar PHI real en staging.
# ─────────────────────────────────────────────────────────────

# Convex (proyecto separado: sephiem-staging)
# Obtener tras `npx convex dev` apuntando al deployment de staging.
VITE_CONVEX_URL=https://<staging-deployment>.convex.cloud
CONVEX_DEPLOYMENT=<staging-deployment-name>
# Deploy key del deployment de staging (Convex Dashboard > Settings > Deploy Keys).
# Se usa en CI/Railway para `npx convex deploy` sin login interactivo.
CONVEX_DEPLOY_KEY=

# Privy (app de staging separada de producción)
VITE_PRIVY_APP_ID=<staging-privy-app-id>

# Auth Web3 / Custom JWT (ES256) — claves del entorno de staging.
# Generadas según A0 spike. NO reutilizar las de producción.
JWKS=
JWT_PRIVATE_KEY=
